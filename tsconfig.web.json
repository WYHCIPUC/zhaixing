{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "useDefineForClassFields": true,
    "noEmit": true,
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*"],
  "exclude": [
    "node_modules",
    "out",
    "dist-mobile",
    "src/shared/db/test-executor.ts",
    "src/shared/db/apply-schema.test.ts",
    "src/shared/db/async-repo.test.ts",
    "src/shared/weread/api.live.test.ts",
    "src/renderer/src/api/mobile-api.test.ts"
  ]
}
